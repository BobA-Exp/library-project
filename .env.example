OPENLIBRARY_BASE_URL=https://openlibrary.org
DATABASE_PATH=data/library.db
CACHE_TTL_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=30.0
REPORT_OUTPUT_DIR=data/outputs
LOG_LEVEL=INFO
LOG_FILE=logs/library.log
MAX_RETRIES=3

# Local Experian network only. Leave LIBRARY_INSECURE_SSL=0 outside that network.
HTTPS_PROXY=
HTTP_PROXY=
LIBRARY_INSECURE_SSL=0
